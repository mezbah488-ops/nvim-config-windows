{
  "mdframed": {
    "prefix": "mdframe",
    "body": ["\\begin{mdframed}", "\t${1}", "\\end{mdframed}"],
    "description": "mdframed environment"
  },

  "Centered Incfig [Half Scale]": {
    "prefix": "incfig_center",
    "body": "\\begin{center}\n\t$$\\vcenter{\\hbox{\\scriptsize \\incfig[0.5]{$1}}}$$\n\\end{center}${0}",
    "description": "Centered half-scale incfig figure"
  },

  "Preamble": {
    "prefix": "preamble",
    "body": [
      "\\documentclass[11pt,a4paper]{article}",
      "",
      "% --- Page layout ---",
      "\\usepackage[margin=1in]{geometry}",
      "\\usepackage{microtype}",
      "\\usepackage{fancyhdr}",
      "\\setlength{\\headheight}{14pt}",
      "",
      "% --- Math ---",
      "\\usepackage{amsmath, amssymb, amsfonts}",
      "\\usepackage{amsthm}",
      "\\usepackage{mathtools}",
      "\\usepackage{bbold}",
      "\\usepackage{slashed}",
      "\\usepackage{braket}",
      "\\usepackage{cancel}",
      "",
      "% --- Theorems ---",
      "\\newtheorem{theorem}{Theorem}",
      "",
      "% --- Figures ---",
      "\\usepackage{graphicx}",
      "\\usepackage{float}",
      "\\usepackage{caption}",
      "\\usepackage{wrapfig}",
      "\\usepackage{import}",
      "\\usepackage{xifthen}",
      "\\usepackage{pdfpages}",
      "\\usepackage{transparent}",
      "\\newcommand{\\incfig}[2][1]{%",
      "\\edef\\svgwidth{#1\\columnwidth}",
      "\\import{./figures/}{#2.pdf_tex}",
      "}",
      "\\pdfsuppresswarningpagegroup=1",
      "",
      "% --- TikZ & PGF ---",
      "\\usepackage{tikz}",
      "\\usetikzlibrary{calc, intersections, arrows.meta, decorations.pathmorphing}",
      "\\usepackage{pgfplots}",
      "\\usepgfplotslibrary{fillbetween}",
      "\\pgfplotsset{compat=1.18}",
      "",
      "% --- Misc ---",
      "\\usepackage{soul}",
      "\\usepackage[colorlinks=true, linkcolor=blue, urlcolor=blue]{hyperref}",
      "\\usepackage{xurl}",
      "",
      "\\title{${1:Title}}",
      "\\author{${2:Author}}",
      "\\date{${3:Date}}",
      "",
      "\\begin{document}",
      "\\maketitle",
      "\\thispagestyle{fancy}",
      "\\fancyhf{}",
      "\\fancyhead[R]{Md. Mezbah Uddin}",
      "\\renewcommand{\\headrulewidth}{0pt}",
      "\\tableofcontents",
      "\\newpage",
      "$0",
      "\\end{document}"
    ],
    "description": "Full LaTeX preamble"
  },

  "Textcolor": {
    "prefix": "color",
    "body": ["\\textcolor{${1:red}}{${2}}"],
    "description": "Colored text with xcolor"
  },

  "vcenter incfig inline": {
    "prefix": "incfig_inline",
    "body": ["$\\vcenter{\\hbox{\\scriptsize \\incfig[0.5]{${1:}}}}$"],
    "description": "Inline math vertically centered incfig"
  },

  "Inkscape Figure": {
    "prefix": "incfig",
    "body": [
      "\\begin{figure}[ht]",
      "\t\\centering",
      "\t\\incfig[${1:0.5}]{${2:figure_name}}",
      "\t\\caption{${3:Your caption here}}",
      "\\end{figure}"
    ],
    "description": "Insert Inkscape figure, optional arg is a scale factor (0 to 1)"
  },

  "Exercise (tcolorbox)": {
    "prefix": "ex",
    "body": [
      "\\begin{exercise}{${1}}{${2:label}}",
      "\t${3:Exercise content here...}",
      "\\end{exercise}"
    ],
    "description": "Insert tcolorbox exercise environment"
  },

  "Exercise Reference": {
    "prefix": "exref",
    "body": "\\ref{ex:${1:label}}",
    "description": "Reference an exercise by its label"
  },

  "Unnumbered align": {
    "prefix": "al",
    "body": "\\begin{align*}\n\t$1\n\\end{align*}",
    "description": "Insert unnumbered align environment"
  },

  "Unnumbered equation": {
    "prefix": "eq",
    "body": "\\[\n\t$1\n\\]",
    "description": "Insert unnumbered display equation"
  },

  "Numbered Equation with Label": {
    "prefix": "equ",
    "body": ["\\begin{equation}", "\t${1}", "\t\\label{eq:${2:name}}", "\\end{equation}${0}"],
    "description": "Insert a numbered equation with a label"
  },

  "LaTeX environment": {
    "prefix": "env",
    "body": ["\\begin{$1}", "\t$0", "\\end{$1}"],
    "description": "Generic LaTeX environment with mirrored name"
  },

  "Implies symbol": {
    "prefix": "implies",
    "body": "\\implies",
    "description": "Implies symbol (⟹)"
  },

  "Doteq symbol": {
    "prefix": "doteq",
    "body": "\\doteq",
    "description": "Dot over equals symbol (≐)"
  },

  "Reference": {
    "prefix": "ref",
    "body": "\\ref{${1}}${0}",
    "description": "Insert reference"
  },

  "Equation Reference": {
    "prefix": "eqref",
    "body": "Eq.\\eqref{eq:${1:label}}${0}",
    "description": "Insert 'Eq. (label)' reference"
  },

  "Label Equation": {
    "prefix": "lab",
    "body": "\\label{eq:${1:name}}${0}",
    "description": "Insert an equation label with eq: prefix"
  },

  "Scri": {
    "prefix": "scr",
    "body": "\\mathscr{${1}}${0}",
    "description": "Insert mathscr (script) font"
  },

  "2x2 Matrix": {
    "prefix": "mat2",
    "body": "\\begin{pmatrix}\n${1:a} & ${2:b} \\\\\n${3:c} & ${4:d}\n\\end{pmatrix}${0}",
    "description": "Insert 2x2 matrix"
  },

  "Matrix (generic)": {
    "prefix": "mat",
    "body": ["\\begin{${1:p}matrix}", "\t$0", "\\end{${1:p}matrix}"],
    "description": "Matrix environment — replace 'p' with b/v/V/B/small as needed"
  },

  "Dot Above": {
    "prefix": "dot",
    "body": "\\dot{${1:x}}${0}",
    "description": "Insert dot above letter"
  },

  "Double Dot": {
    "prefix": "ddot",
    "body": "\\ddot{${1:x}}${0}",
    "description": "Insert double dot above letter"
  },

  "Quad Space": {
    "prefix": "quad",
    "body": "\\quad${0}",
    "description": "Insert quad space in math mode"
  },

  "Theorem Environment": {
    "prefix": "thm",
    "body": "\\begin{theorem}[${1:title}]\n\t${2:statement}\n\\end{theorem}${0}",
    "description": "Insert theorem environment"
  },

  "Plus Minus": {
    "prefix": "pm",
    "body": "\\pm${0}",
    "description": "Insert plus minus symbol ±"
  },

  "Nabla": {
    "prefix": "nab",
    "body": "\\nabla${0}",
    "description": "Insert nabla symbol"
  },

  "Bold Nabla": {
    "prefix": "bnabla",
    "body": "\\boldsymbol{\\nabla}${0}",
    "description": "Insert boldface nabla symbol"
  },

  "Bold Symbol": {
    "prefix": "bsym",
    "body": "\\boldsymbol{${1:symbol}}${0}",
    "description": "Insert bold math symbol using boldsymbol"
  },

  "Underset with Two Conditions": {
    "prefix": "us2",
    "body": "\\underset{\\substack{\\scriptstyle ${1:cond1}\\\\ \\scriptstyle ${2:cond2}}}{${3:expr}}${0}",
    "description": "Underset with two scriptstyle conditions"
  },

  "Underset with One Condition": {
    "prefix": "us1",
    "body": "\\underset{\\scriptstyle ${1:cond}}{${2:expr}}${0}",
    "description": "Underset with one scriptstyle condition"
  },

  "Limit": {
    "prefix": "lim",
    "body": "\\lim_{${1:n} \\to ${2:\\infty}} ${3}${0}",
    "description": "Insert limit with variable approaching value"
  },

  "Matrix Element": {
    "prefix": "mel",
    "body": "\\langle ${1:\\psi} | ${2:\\hat{O}} | ${3:\\phi} \\rangle${0}",
    "description": "Insert general matrix element ⟨ψ|O|φ⟩"
  },

  "Expectation Value (Same State)": {
    "prefix": "expval",
    "body": "\\langle ${1:\\psi} | ${2:\\hat{O}} | ${1:\\psi} \\rangle${0}",
    "description": "Insert expectation value ⟨ψ|O|ψ⟩ with same bra and ket"
  },

  "Underbrace": {
    "prefix": "under",
    "body": "\\underbrace{${1:expr}}_{${2:label}}${0}",
    "description": "Insert underbrace with label"
  },

  "Overset": {
    "prefix": "overset",
    "body": "\\overset{${1:above}}{${2:main}}${0}",
    "description": "Insert overset"
  },

  "Underset": {
    "prefix": "undset",
    "body": "\\underset{${1:below}}{${2:main}}${0}",
    "description": "Insert underset"
  },

  "First Order Derivative": {
    "prefix": "d1",
    "body": "\\frac{d ${1:y}}{d ${2:x}}${0}",
    "description": "First derivative dy/dx"
  },

  "Second Order Derivative": {
    "prefix": "d2",
    "body": "\\frac{d^{2} ${1:y}}{d ${2:x}^{2}}${0}",
    "description": "Second derivative d²y/dx²"
  },

  "Third Order Derivative": {
    "prefix": "d3",
    "body": "\\frac{d^{3} ${1:y}}{d ${2:x}^{3}}${0}",
    "description": "Third derivative d³y/dx³"
  },

  "Bra": {
    "prefix": "bra",
    "body": "\\langle ${1} |${0}",
    "description": "Bra ⟨ψ|"
  },

  "Ket": {
    "prefix": "ket",
    "body": "| ${1} \\rangle${0}",
    "description": "Ket |ψ⟩"
  },

  "Inner Product": {
    "prefix": "ip",
    "body": "\\langle ${1:\\psi} | ${2:\\phi} \\rangle${0}",
    "description": "Inner product ⟨ψ|φ⟩"
  },

  "Inner Product (comma notation)": {
    "prefix": "ipc",
    "body": "\\langle ${1:\\psi} , ${2:\\phi} \\rangle${0}",
    "description": "Inner product ⟨ψ,φ⟩"
  },

  "Outer Product": {
    "prefix": "op",
    "body": "| ${1:\\psi} \\rangle \\langle ${2:\\phi} |${0}",
    "description": "Outer product |ψ⟩⟨φ|"
  },

  "Infinity": {
    "prefix": "inf",
    "body": "\\infty${0}",
    "description": "Infinity symbol"
  },

  "Double Right Arrow": {
    "prefix": "Rarr",
    "body": "\\Rightarrow${0}",
    "description": "Double right arrow ⟹"
  },

  "Right Arrow": {
    "prefix": "rarr",
    "body": "\\rightarrow${0}",
    "description": "Right arrow →"
  },

  "Left Arrow": {
    "prefix": "larr",
    "body": "\\leftarrow${0}",
    "description": "Left arrow ←"
  },

  "Long Right Arrow": {
    "prefix": "lrarr",
    "body": "\\longrightarrow${0}",
    "description": "Long right arrow ⟶"
  },

  "Hat Accent": {
    "prefix": "hat",
    "body": "\\hat{${1:x}}${0}",
    "description": "Hat accent"
  },

  "Math Text": {
    "prefix": "mtext",
    "body": "\\text{${1}}${0}",
    "description": "Text inside math mode"
  },

  "Bold Text": {
    "prefix": "bf",
    "body": "\\textbf{${1}}${0}",
    "description": "Bold text"
  },

  "Italic Text": {
    "prefix": "it",
    "body": "\\textit{${1}}${0}",
    "description": "Italic text"
  },

  "Ellipsis": {
    "prefix": "dots",
    "body": "\\dots${0}",
    "description": "Ellipsis \\dots"
  },

  "Math Cal": {
    "prefix": "mca",
    "body": "\\mathcal{${1}}${0}",
    "description": "Calligraphic font \\mathcal"
  },

  "Big O / Order of Magnitude": {
    "prefix": "ord",
    "body": "\\mathcal{O}(${1:n^2})${0}",
    "description": "Big-O / order of magnitude"
  },

  "Math Bold": {
    "prefix": "mbo",
    "body": "\\mathbf{${1:v}}${0}",
    "description": "Bold math font \\mathbf"
  },

  "Much Less Than": {
    "prefix": "ll",
    "body": "\\ll${0}",
    "description": "Much less than ≪"
  },

  "Much Greater Than": {
    "prefix": "gg",
    "body": "\\gg${0}",
    "description": "Much greater than ≫"
  },

  "Approximation": {
    "prefix": "appr",
    "body": "\\approx${0}",
    "description": "Approximation ≈"
  },

  "Congruence": {
    "prefix": "cong",
    "body": "\\cong${0}",
    "description": "Congruence ≅"
  },

  "Sim": {
    "prefix": "sim",
    "body": "\\sim${0}",
    "description": "Tilde/sim ~"
  },

  "Belongs To": {
    "prefix": "inn",
    "body": "\\in${0}",
    "description": "Element-of symbol ∈"
  },

  "Inline Math": {
    "prefix": "im",
    "body": "\\$${1}\\$${0}",
    "description": "Inline math $ $"
  },

  "Display Math": {
    "prefix": "dm",
    "body": "\\[\n\t${1}\n\\]${0}",
    "description": "Display math \\[ \\]"
  },

  "Scaling Parentheses": {
    "prefix": "lp",
    "body": "\\left( ${1} \\right)${0}",
    "description": "Auto-scaling parentheses"
  },

  "Scaling Curly Braces": {
    "prefix": "lc",
    "body": "\\left\\{ ${1} \\right\\}${0}",
    "description": "Auto-scaling curly braces"
  },

  "Scaling Square Brackets": {
    "prefix": "lb",
    "body": "\\left[ ${1} \\right]${0}",
    "description": "Auto-scaling square brackets"
  },

  "Scaling Absolute Value": {
    "prefix": "lv",
    "body": "\\left| ${1} \\right|${0}",
    "description": "Auto-scaling absolute value bars"
  },

  "Scaling Norm": {
    "prefix": "lnorm",
    "body": "\\left\\| ${1} \\right\\|${0}",
    "description": "Auto-scaling norm double bars"
  },

  "Commutator": {
    "prefix": "comm",
    "body": "\\left[ ${1:A}, ${2:B} \\right]${0}",
    "description": "Commutator [A, B]"
  },

  "Anti-commutator": {
    "prefix": "acomm",
    "body": "\\left\\{ ${1:A}, ${2:B} \\right\\}${0}",
    "description": "Anti-commutator {A, B}"
  },

  "Square Root": {
    "prefix": "sqrt",
    "body": "\\sqrt{${1:x}}${0}",
    "description": "Square root"
  },

  "N-th Root": {
    "prefix": "nrt",
    "body": "\\sqrt[${1:n}]{${2:x}}${0}",
    "description": "N-th root"
  },

  "Feynman Slash": {
    "prefix": "slash",
    "body": "\\slashed{${1}}${0}",
    "description": "Feynman slash notation"
  },

  "Fraction": {
    "prefix": "frac",
    "body": "\\frac{${1}}{${2}}${0}",
    "description": "Fraction"
  },

  "Partial Derivative": {
    "prefix": "pdiff",
    "body": "\\frac{\\partial ${1:f}}{\\partial ${2:x}}${0}",
    "description": "Partial derivative"
  },

  "Partial Symbol": {
    "prefix": "pa",
    "body": "\\partial${0}",
    "description": "Partial derivative symbol ∂"
  },

  "First Order Total Derivative": {
    "prefix": "d1",
    "body": "\\frac{d ${1:y}}{d ${2:x}}${0}",
    "description": "First total derivative"
  },

  "4D Momentum Integral": {
    "prefix": "d4p",
    "body": "\\int \\frac{d^4 ${1:p}}{(2\\pi)^4}\\, ${0}",
    "description": "4D momentum space integral measure"
  },

  "3D Momentum Integral": {
    "prefix": "d3p",
    "body": "\\int \\frac{d^3 ${1:p}}{(2\\pi)^3}\\, ${0}",
    "description": "3D momentum space integral measure"
  },

  "Integral": {
    "prefix": "int",
    "body": "\\int_{${1}}^{${2}} ${3} \\, d${4}${0}",
    "description": "General integral"
  },

  "Integral (infinite limits)": {
    "prefix": "intf",
    "body": "\\int_{-\\infty}^{+\\infty} ${1} \\, d${2}${0}",
    "description": "Integral from -∞ to +∞"
  },

  "Definite Integral": {
    "prefix": "dint",
    "body": "\\int_{${1:a}}^{${2:b}} ${3:f(x)} \\, d${4:x}${0}",
    "description": "Definite integral"
  },

  "Double Integral": {
    "prefix": "iint",
    "body": "\\iint_{${1:D}} ${2:f(x,y)} \\, d${3:A}${0}",
    "description": "Double integral"
  },

  "Triple Integral": {
    "prefix": "iiint",
    "body": "\\iiint_{${1:V}} ${2:f} \\, d${3:V}${0}",
    "description": "Triple integral"
  },

  "Contour Integral": {
    "prefix": "oint",
    "body": "\\oint_{${1:C}} ${2:f(z)} \\, d${3:z}${0}",
    "description": "Contour integral"
  },

  "Summation": {
    "prefix": "summ",
    "body": "\\sum_{${1:n}=${2:0}}^{${3:\\infty}} ${0}",
    "description": "Summation with limits"
  },

  "Product": {
    "prefix": "prodd",
    "body": "\\prod_{${1:n}=${2:0}}^{${3:\\infty}} ${0}",
    "description": "Product with limits"
  },

  "Relativistic Energy": {
    "prefix": "enp",
    "body": "\\sqrt{\\mathbf{${1:p}}^2 + ${2:m}^2}${0}",
    "description": "Relativistic energy √(p²+m²)"
  },

  "Bar Notation": {
    "prefix": "bar",
    "body": "\\bar{${1:x}}${0}",
    "description": "Bar over a symbol"
  },

  "Tilde": {
    "prefix": "tilde",
    "body": "\\tilde{${1:x}}${0}",
    "description": "Tilde accent"
  },

  "Vec": {
    "prefix": "vec",
    "body": "\\vec{${1:v}}${0}",
    "description": "Vector arrow"
  },

  "Varphi": {
    "prefix": "varphi",
    "body": "\\varphi${0}",
    "description": "Variant phi φ"
  },

  "Varepsilon": {
    "prefix": "varepsilon",
    "body": "\\varepsilon${0}",
    "description": "Variant epsilon ε"
  },

  "Varpi": {
    "prefix": "varpi",
    "body": "\\varpi${0}",
    "description": "Variant pi ϖ"
  },

  "Horizontal Rule": {
    "prefix": "hrule",
    "body": "\\bigskip\n\\hrule\n\\bigskip",
    "description": "Horizontal rule with vertical spacing"
  },

  "Figure": {
    "prefix": "fig",
    "body": [
      "\\begin{figure}[H]",
      "\t\\centering",
      "\t\\includegraphics[width=${1:0.8}\\textwidth]{${2:filename}}",
      "\t\\caption{${3:caption}}",
      "\t\\label{fig:${4:label}}",
      "\\end{figure}${0}"
    ],
    "description": "Centered figure with caption and label"
  },

  "Section": {
    "prefix": "sec",
    "body": ["\\section{${1:Title}}", "${0}"],
    "description": "Section"
  },

  "Subsection": {
    "prefix": "ssec",
    "body": ["\\subsection{${1:Title}}", "${0}"],
    "description": "Subsection"
  },

  "Subsubsection": {
    "prefix": "sssec",
    "body": ["\\subsubsection{${1:Title}}", "${0}"],
    "description": "Subsubsection"
  },

  "Chapter": {
    "prefix": "cha",
    "body": ["\\chapter{${1:Title}}", "${0}"],
    "description": "Chapter"
  },

  "Paragraph heading": {
    "prefix": "par",
    "body": ["\\paragraph{${1:Title}}", "${0}"],
    "description": "Paragraph heading"
  },

  "Itemize": {
    "prefix": "itemize",
    "body": ["\\begin{itemize}", "\t\\item ${1}", "\\end{itemize}${0}"],
    "description": "Itemize list"
  },

  "Enumerate": {
    "prefix": "enumerate",
    "body": ["\\begin{enumerate}", "\t\\item ${1}", "\\end{enumerate}${0}"],
    "description": "Enumerated list"
  },

  "Description": {
    "prefix": "desc",
    "body": ["\\begin{description}", "\t\\item[${1:term}] ${2}", "\\end{description}${0}"],
    "description": "Description list"
  },

  "Cases": {
    "prefix": "cas",
    "body": [
      "\\begin{cases}",
      "\t${1:expr}, & \\text{if } ${2:cond} \\\\",
      "\t${3:expr}, & \\text{otherwise}",
      "\\end{cases}${0}"
    ],
    "description": "Cases environment"
  },

  "Split": {
    "prefix": "spl",
    "body": ["\\begin{split}", "\t${1} &= ${2} \\\\", "\t${0}", "\\end{split}"],
    "description": "Split environment (inside equation)"
  },

  "Gather": {
    "prefix": "gat",
    "body": ["\\begin{gather*}", "\t${1}", "\\end{gather*}${0}"],
    "description": "Gather environment (unnumbered)"
  },

  "Tabular": {
    "prefix": "tab",
    "body": [
      "\\begin{tabular}{${1:ll}}",
      "\t\\hline",
      "\t${2:Col1} & ${3:Col2} \\\\",
      "\t\\hline",
      "\t${0}",
      "\t\\hline",
      "\\end{tabular}"
    ],
    "description": "Simple tabular environment"
  },

  "Table (float)": {
    "prefix": "table",
    "body": [
      "\\begin{table}[H]",
      "\t\\centering",
      "\t\\caption{${1:caption}}",
      "\t\\label{tab:${2:label}}",
      "\t\\begin{tabular}{${3:ll}}",
      "\t\t\\hline",
      "\t\t${4:Col1} & ${5:Col2} \\\\",
      "\t\t\\hline",
      "\t\t${0}",
      "\t\t\\hline",
      "\t\\end{tabular}",
      "\\end{table}"
    ],
    "description": "Table float with tabular inside"
  },

  "Proof": {
    "prefix": "proof",
    "body": ["\\begin{proof}", "\t${1}", "\\end{proof}${0}"],
    "description": "Proof environment"
  },

  "Definition": {
    "prefix": "defn",
    "body": ["\\begin{definition}", "\t${1}", "\\end{definition}${0}"],
    "description": "Definition environment"
  },

  "Block Quote": {
    "prefix": "bquote",
    "body": ["\\begin{quote}", "\t${1}", "\\end{quote}${0}"],
    "description": "Block quote environment"
  },

  "Inline Quote": {
    "prefix": "iquote",
    "body": "``${1}''${0}",
    "description": "Inline LaTeX-style double quotes"
  },

  "URL Link": {
    "prefix": "url",
    "body": "\\url{${1}}${0}",
    "description": "Plain URL"
  },

  "Hyperlink": {
    "prefix": "href",
    "body": "\\href{${1:https://}}{${2:text}}${0}",
    "description": "Hyperlink with custom text"
  },

  "Hyperlink with Footnote": {
    "prefix": "hreffoot",
    "body": "\\href{${1:https://}}{${2:text}}\\footnote{\\url{${1}}}${0}",
    "description": "Hyperlink with URL repeated in footnote"
  },

  "Internal Hyperref": {
    "prefix": "hyperref",
    "body": "\\hyperref[${1:label}]{${2:text}}${0}",
    "description": "Link to an internal label"
  },

  "Mailto Link": {
    "prefix": "mailto",
    "body": "\\href{mailto:${1}}{${2}}${0}",
    "description": "Email mailto link"
  },

  "Cite": {
    "prefix": "cite",
    "body": "\\cite{${1}}${0}",
    "description": "Citation"
  },

  "Figure Ref": {
    "prefix": "figref",
    "body": "Fig.~\\ref{fig:${1:label}}${0}",
    "description": "Figure reference"
  },

  "Table Ref": {
    "prefix": "tabref",
    "body": "Table~\\ref{tab:${1:label}}${0}",
    "description": "Table reference"
